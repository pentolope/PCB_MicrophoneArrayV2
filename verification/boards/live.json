    "description": "Every command a clean-room release runs, and the field names the artifacts it generates actually carry. The ERC and DRC option sets are taken from the validator so a release cannot run a weaker check than validation demands.",
    "lock_file_globs": [
      "*.lck",
      "~*.lck",
      ".#*",
      "*-lock",
      "*.kicad_prl-lock"
    ],
    "purge_globs": [
      "generated/**",
      "generated"
    ],
    "erc": {
      "output": "erc.json"
    },
    "drc": {
      "output": "drc.json"
    },
    "drill": {
      "flags": [
        "--format",
        "excellon",
        "--excellon-separate-th",
        "--drill-origin",
        "plot"
      ]
    },
    "bom": {
      "output": "bom.csv",
      "fields": [
        "${QUANTITY}",
        "Reference",
        "Value",
        "Footprint",
        "LCSC"
      ],
      "labels": [
        "Quantity",
        "Designator",
        "Comment",
        "Footprint",
        "LCSC Part #"
      ],
      "group_by": [
        "Value",
        "Footprint",
        "LCSC"
      ],
      "flags": [
        "--exclude-dnp",
        "--ref-range-delimiter",
        ""
      ],
      "field_map": {
        "designators": "Designator",
        "value": "Comment",
        "footprint": "Footprint",
        "quantity": "Quantity",
        "LCSC": "LCSC Part #"
      }
    },
    "cpl": {
      "output": "cpl.csv",
      "flags": [
        "--format",
        "csv",
        "--units",
        "mm",
        "--side",
        "both",
        "--exclude-dnp"
      ],
      "field_map": {
        "designator": "Ref",
        "x": "PosX",
        "y": "PosY",
        "side": "Side",
        "rotation": "Rot"
      },
      "origin": {
        "frame": "absolute page origin",
        "offset_mm": [
          0.0,
          0.0
        ]
      }
    },
    "archive": {
      "zip": "microphone_array_v2-revA-fabrication.zip",
      "manifest": "MANIFEST.md"
    }
  },
  "advisory_gates": [
    {
      "gate": "ROUTE.ANGLE_STYLE",
      "reason": "Octolinear style, on a board whose architecture is polar. The supply ring follows a circle, sixteen data spokes and sixteen clock arms run on radii, and the clock trunks walk a ring: none of that lands on a 0/45 degree turn, and forcing it to would make the geometry worse, not the board better. The manufacturable concern in this measurement is the acute corner, and tools/check_routes.py reports those separately. Kept as a measurement so a genuine regression is still visible."
    },
    {
      "gate": "ROUTE.TINY_SEGMENTS",
      "reason": "Every ordinary net on this board is routed by KiCad Routing Tools, and its fine-grid tap retries emit 0.07 to 0.14 mm legs where an escape is tight. Those retries are what make the escapes route at all, the router offers no setting to coarsen them, and shortening the fragments afterwards would mean editing routed copper by hand - which this board's process forbids. No fragment is a sliver in copper: they are collinear continuations at full track width."
    }
  ]
}
